# AuraJewel Backend Environment Configuration
PORT=5001
NODE_ENV=development

# MongoDB Connection String (Atlas or Local)
# If left as mongodb://localhost:27017/aurajewel and unreachable, the server falls back to embedded in-memory MongoDB for instant local testing!
MONGODB_URI=mongodb://localhost:27017/aurajewel_saas

# Allow automated in-memory MongoDB fallback if external cluster connection fails in development
USE_MEMORY_DB_FALLBACK=true

# JWT Secrets (Generate strong random strings in production)
JWT_ACCESS_SECRET=aurajewel_super_secret_access_jwt_key_2026_luxury_jewel_token
JWT_REFRESH_SECRET=aurajewel_super_secret_refresh_jwt_key_2026_luxury_jewel_token
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Frontend CORS Origin
CLIENT_URL=http://localhost:5173

# Future Integration Placeholders (Phase 3 & Phase 4)
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_ACCESS_TOKEN=
META_WHATSAPP_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=
META_WHATSAPP_SENDER_PHONE=+919284571131
META_WHATSAPP_TEMPLATE_NAME=hello_world
META_WHATSAPP_TEMPLATE_LANGUAGE=en_US
META_WHATSAPP_GRAPH_API_VERSION=v23.0
META_WHATSAPP_TEST_MODE=true
META_WHATSAPP_TEST_RECIPIENT=
# For non-hello_world templates, approve a body with {{1}} customer name,
# {{2}} invoice number, {{3}} shop name, and {{4}} formatted total.

GOOGLE_BUSINESS_CLIENT_ID=
GOOGLE_BUSINESS_CLIENT_SECRET=
GOOGLE_BUSINESS_REDIRECT_URI=http://localhost:5000/api/v1/google-reviews/callback

AWS_S3_BUCKET_NAME=
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
